# Copier ce fichier en « .env » et renseigner vos identifiants PostgreSQL.
# Le fichier .env réel n'est PAS versionné (voir .gitignore).

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe

# Data warehouse analytique (données territoriales TTA)
DB_NAME=dwh_orvsit

# Base applicative (utilisateurs, demandes d'accès, assistant IA)
APP_DB_NAME=orvsit_app

# --- Authentification (JWT) ---
# Clé secrète qui signe les jetons. Générez-en une longue et aléatoire,
# par exemple avec :  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=remplacez_par_une_cle_longue_et_aleatoire
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- E-mail (SMTP) ---
# Laisser SMTP_HOST vide = mode "console" (les e-mails s'affichent dans le terminal).
# Pour envoyer de vrais e-mails via Gmail : activer la validation en 2 étapes,
# créer un « mot de passe d'application », puis renseigner ci-dessous.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=mot_de_passe_application_16_caracteres
SMTP_FROM=ORVSIT <votre.email@gmail.com>

# Clé API du fournisseur LLM pour l'assistant IA (si utilisé)
# LLM_API_KEY=
